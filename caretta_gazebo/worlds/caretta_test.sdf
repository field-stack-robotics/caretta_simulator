<?xml version="1.0" ?>
<!-- Caretta test world (Ignition Gazebo Fortress): ground, light, sensors system and a few
     obstacles around the spawn point so the LiDAR has something to see. -->
<sdf version="1.8">
  <world name="caretta_test">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-contact-system" name="gz::sim::systems::Contact"/>
    <!-- needed for every sensor (gpu_lidar, camera ...) -->
    <plugin filename="ignition-gazebo-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <!-- needed for the IMU sensor (BNO055) -->
    <plugin filename="ignition-gazebo-imu-system" name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 4 x 4 m room: walls 0.3 m high (above the LiDAR scan plane at ~0.146 m) -->
    <model name="walls">
      <static>true</static>
      <link name="link">
        <collision name="north"><pose>2 0 0.15 0 0 0</pose><geometry><box><size>0.05 4 0.3</size></box></geometry></collision>
        <visual name="north"><pose>2 0 0.15 0 0 0</pose><geometry><box><size>0.05 4 0.3</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
        <collision name="south"><pose>-2 0 0.15 0 0 0</pose><geometry><box><size>0.05 4 0.3</size></box></geometry></collision>
        <visual name="south"><pose>-2 0 0.15 0 0 0</pose><geometry><box><size>0.05 4 0.3</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
        <collision name="east"><pose>0 -2 0.15 0 0 0</pose><geometry><box><size>4 0.05 0.3</size></box></geometry></collision>
        <visual name="east"><pose>0 -2 0.15 0 0 0</pose><geometry><box><size>4 0.05 0.3</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
        <collision name="west"><pose>0 2 0.15 0 0 0</pose><geometry><box><size>4 0.05 0.3</size></box></geometry></collision>
        <visual name="west"><pose>0 2 0.15 0 0 0</pose><geometry><box><size>4 0.05 0.3</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
      </link>
    </model>

    <model name="box_1">
      <static>true</static>
      <pose>1.0 0.6 0.15 0 0 0.4</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.3 0.3 0.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.3 0.3 0.3</size></box></geometry>
          <material><ambient>0.8 0.3 0.2 1</ambient><diffuse>0.8 0.3 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <model name="cylinder_1">
      <static>true</static>
      <pose>-0.8 -0.9 0.2 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.15</radius><length>0.4</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.15</radius><length>0.4</length></cylinder></geometry>
          <material><ambient>0.2 0.4 0.8 1</ambient><diffuse>0.2 0.4 0.8 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>
