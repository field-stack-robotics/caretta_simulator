<?xml version="1.0" ?>
<!-- Caretta house world (Ignition Gazebo Fortress): small house with a corridor, three rooms and
     furniture, for driving around and SLAM (mapping). Same plugins as caretta_empty.sdf. -->
<sdf version="1.8">
  <world name="caretta_house">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-contact-system" name="gz::sim::systems::Contact"/>
    <!-- needed for every sensor (gpu_lidar, camera ...) -->
    <plugin filename="ignition-gazebo-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <!-- needed for the IMU sensor (BNO055) -->
    <plugin filename="ignition-gazebo-imu-system" name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- House: 8 x 6 m, walls 0.5 m high (LiDAR scan plane ~0.146 m). Robot spawns at (0, 0)
         in the middle of the corridor (y -0.6..0.6), facing +x. Doors are 0.8 m wide.
         Two loops for SLAM loop closure: corridor <-> living room (2 doors), and the two
         north rooms (door between them). -->
    <model name="house">
      <static>true</static>
      <link name="link">
        <collision name="outer_north_collision"><pose>0 3 0.25 0 0 0</pose><geometry><box><size>8.1 0.1 0.5</size></box></geometry></collision>
        <visual name="outer_north_visual"><pose>0 3 0.25 0 0 0</pose><geometry><box><size>8.1 0.1 0.5</size></box></geometry><material><ambient>0.55 0.58 0.62 1</ambient><diffuse>0.55 0.58 0.62 1</diffuse></material></visual>
        <collision name="outer_south_collision"><pose>0 -3 0.25 0 0 0</pose><geometry><box><size>8.1 0.1 0.5</size></box></geometry></collision>
        <visual name="outer_south_visual"><pose>0 -3 0.25 0 0 0</pose><geometry><box><size>8.1 0.1 0.5</size></box></geometry><material><ambient>0.55 0.58 0.62 1</ambient><diffuse>0.55 0.58 0.62 1</diffuse></material></visual>
        <collision name="outer_west_collision"><pose>-4 0 0.25 0 0 0</pose><geometry><box><size>0.1 6 0.5</size></box></geometry></collision>
        <visual name="outer_west_visual"><pose>-4 0 0.25 0 0 0</pose><geometry><box><size>0.1 6 0.5</size></box></geometry><material><ambient>0.55 0.58 0.62 1</ambient><diffuse>0.55 0.58 0.62 1</diffuse></material></visual>
        <collision name="outer_east_collision"><pose>4 0 0.25 0 0 0</pose><geometry><box><size>0.1 6 0.5</size></box></geometry></collision>
        <visual name="outer_east_visual"><pose>4 0 0.25 0 0 0</pose><geometry><box><size>0.1 6 0.5</size></box></geometry><material><ambient>0.55 0.58 0.62 1</ambient><diffuse>0.55 0.58 0.62 1</diffuse></material></visual>
        <collision name="corridor_n_1_collision"><pose>-3.2 0.6 0.25 0 0 0</pose><geometry><box><size>1.6 0.1 0.5</size></box></geometry></collision>
        <visual name="corridor_n_1_visual"><pose>-3.2 0.6 0.25 0 0 0</pose><geometry><box><size>1.6 0.1 0.5</size></box></geometry><material><ambient>0.85 0.80 0.70 1</ambient><diffuse>0.85 0.80 0.70 1</diffuse></material></visual>
        <collision name="corridor_n_2_collision"><pose>0 0.6 0.25 0 0 0</pose><geometry><box><size>3.2 0.1 0.5</size></box></geometry></collision>
        <visual name="corridor_n_2_visual"><pose>0 0.6 0.25 0 0 0</pose><geometry><box><size>3.2 0.1 0.5</size></box></geometry><material><ambient>0.85 0.80 0.70 1</ambient><diffuse>0.85 0.80 0.70 1</diffuse></material></visual>
        <collision name="corridor_n_3_collision"><pose>3.2 0.6 0.25 0 0 0</pose><geometry><box><size>1.6 0.1 0.5</size></box></geometry></collision>
        <visual name="corridor_n_3_visual"><pose>3.2 0.6 0.25 0 0 0</pose><geometry><box><size>1.6 0.1 0.5</size></box></geometry><material><ambient>0.85 0.80 0.70 1</ambient><diffuse>0.85 0.80 0.70 1</diffuse></material></visual>
        <collision name="corridor_s_1_collision"><pose>-3.5 -0.6 0.25 0 0 0</pose><geometry><box><size>1 0.1 0.5</size></box></geometry></collision>
        <visual name="corridor_s_1_visual"><pose>-3.5 -0.6 0.25 0 0 0</pose><geometry><box><size>1 0.1 0.5</size></box></geometry><material><ambient>0.85 0.80 0.70 1</ambient><diffuse>0.85 0.80 0.70 1</diffuse></material></visual>
        <collision name="corridor_s_2_collision"><pose>-0.2 -0.6 0.25 0 0 0</pose><geometry><box><size>4 0.1 0.5</size></box></geometry></collision>
        <visual name="corridor_s_2_visual"><pose>-0.2 -0.6 0.25 0 0 0</pose><geometry><box><size>4 0.1 0.5</size></box></geometry><material><ambient>0.85 0.80 0.70 1</ambient><diffuse>0.85 0.80 0.70 1</diffuse></material></visual>
        <collision name="corridor_s_3_collision"><pose>3.3 -0.6 0.25 0 0 0</pose><geometry><box><size>1.4 0.1 0.5</size></box></geometry></collision>
        <visual name="corridor_s_3_visual"><pose>3.3 -0.6 0.25 0 0 0</pose><geometry><box><size>1.4 0.1 0.5</size></box></geometry><material><ambient>0.85 0.80 0.70 1</ambient><diffuse>0.85 0.80 0.70 1</diffuse></material></visual>
        <collision name="divider_1_collision"><pose>0 1.1 0.25 0 0 0</pose><geometry><box><size>0.1 1 0.5</size></box></geometry></collision>
        <visual name="divider_1_visual"><pose>0 1.1 0.25 0 0 0</pose><geometry><box><size>0.1 1 0.5</size></box></geometry><material><ambient>0.70 0.80 0.70 1</ambient><diffuse>0.70 0.80 0.70 1</diffuse></material></visual>
        <collision name="divider_2_collision"><pose>0 2.7 0.25 0 0 0</pose><geometry><box><size>0.1 0.6 0.5</size></box></geometry></collision>
        <visual name="divider_2_visual"><pose>0 2.7 0.25 0 0 0</pose><geometry><box><size>0.1 0.6 0.5</size></box></geometry><material><ambient>0.70 0.80 0.70 1</ambient><diffuse>0.70 0.80 0.70 1</diffuse></material></visual>
      </link>
    </model>

    <!-- furniture: different shapes and sizes, so scans do not look alike -->
    <model name="sofa">
      <static>true</static>
      <pose>0 -2.65 0.2 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.6 0.5 0.4</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.6 0.5 0.4</size></box></geometry><material><ambient>0.30 0.35 0.55 1</ambient><diffuse>0.30 0.35 0.55 1</diffuse></material></visual>
      </link>
    </model>
    <model name="tv_cabinet">
      <static>true</static>
      <pose>3.75 -1.7 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.4 1.2 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 1.2 0.5</size></box></geometry><material><ambient>0.35 0.25 0.20 1</ambient><diffuse>0.35 0.25 0.20 1</diffuse></material></visual>
      </link>
    </model>
    <model name="bed">
      <static>true</static>
      <pose>-3.45 2 0.225 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1 1.9 0.45</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1 1.9 0.45</size></box></geometry><material><ambient>0.85 0.85 0.90 1</ambient><diffuse>0.85 0.85 0.90 1</diffuse></material></visual>
      </link>
    </model>
    <model name="desk">
      <static>true</static>
      <pose>-1 2.7 0.375 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1 0.5 0.75</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1 0.5 0.75</size></box></geometry><material><ambient>0.55 0.40 0.25 1</ambient><diffuse>0.55 0.40 0.25 1</diffuse></material></visual>
      </link>
    </model>
    <model name="chair">
      <static>true</static>
      <pose>-1 2.15 0.225 0 0 0.3</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.4 0.4 0.45</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 0.4 0.45</size></box></geometry><material><ambient>0.20 0.20 0.20 1</ambient><diffuse>0.20 0.20 0.20 1</diffuse></material></visual>
      </link>
    </model>
    <model name="shelf">
      <static>true</static>
      <pose>2.5 2.8 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.5 0.35 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.5 0.35 1</size></box></geometry><material><ambient>0.60 0.45 0.30 1</ambient><diffuse>0.60 0.45 0.30 1</diffuse></material></visual>
      </link>
    </model>
    <model name="armchair">
      <static>true</static>
      <pose>3.4 1.3 0.225 0 0 0.5</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.7 0.7 0.45</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.7 0.7 0.45</size></box></geometry><material><ambient>0.70 0.30 0.25 1</ambient><diffuse>0.70 0.30 0.25 1</diffuse></material></visual>
      </link>
    </model>
    <model name="column">
      <static>true</static>
      <pose>1 -1.5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.15</radius><length>0.5</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.15</radius><length>0.5</length></cylinder></geometry><material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material></visual>
      </link>
    </model>
    <model name="plant_pot">
      <static>true</static>
      <pose>3.5 -2.6 0.2 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.2</radius><length>0.4</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.2</radius><length>0.4</length></cylinder></geometry><material><ambient>0.30 0.55 0.30 1</ambient><diffuse>0.30 0.55 0.30 1</diffuse></material></visual>
      </link>
    </model>
    <model name="round_table">
      <static>true</static>
      <pose>1 2.5 0.35 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.3</radius><length>0.7</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.3</radius><length>0.7</length></cylinder></geometry><material><ambient>0.80 0.70 0.55 1</ambient><diffuse>0.80 0.70 0.55 1</diffuse></material></visual>
      </link>
    </model>
    <!-- the LiDAR sees only the legs; the top is above the scan plane -->
    <model name="dining_table">
      <static>true</static>
      <pose>-2.5 -2 0 0 0 0</pose>
      <link name="link">
        <collision name="top_collision"><pose>0 0 0.705 0 0 0</pose><geometry><box><size>1.2 0.8 0.03</size></box></geometry></collision>
        <visual name="top_visual"><pose>0 0 0.705 0 0 0</pose><geometry><box><size>1.2 0.8 0.03</size></box></geometry><material><ambient>0.55 0.40 0.25 1</ambient><diffuse>0.55 0.40 0.25 1</diffuse></material></visual>
        <collision name="leg_0_collision"><pose>0.54 0.34 0.345 0 0 0</pose><geometry><cylinder><radius>0.025</radius><length>0.69</length></cylinder></geometry></collision>
        <visual name="leg_0_visual"><pose>0.54 0.34 0.345 0 0 0</pose><geometry><cylinder><radius>0.025</radius><length>0.69</length></cylinder></geometry><material><ambient>0.55 0.40 0.25 1</ambient><diffuse>0.55 0.40 0.25 1</diffuse></material></visual>
        <collision name="leg_1_collision"><pose>-0.54 0.34 0.345 0 0 0</pose><geometry><cylinder><radius>0.025</radius><length>0.69</length></cylinder></geometry></collision>
        <visual name="leg_1_visual"><pose>-0.54 0.34 0.345 0 0 0</pose><geometry><cylinder><radius>0.025</radius><length>0.69</length></cylinder></geometry><material><ambient>0.55 0.40 0.25 1</ambient><diffuse>0.55 0.40 0.25 1</diffuse></material></visual>
        <collision name="leg_2_collision"><pose>0.54 -0.34 0.345 0 0 0</pose><geometry><cylinder><radius>0.025</radius><length>0.69</length></cylinder></geometry></collision>
        <visual name="leg_2_visual"><pose>0.54 -0.34 0.345 0 0 0</pose><geometry><cylinder><radius>0.025</radius><length>0.69</length></cylinder></geometry><material><ambient>0.55 0.40 0.25 1</ambient><diffuse>0.55 0.40 0.25 1</diffuse></material></visual>
        <collision name="leg_3_collision"><pose>-0.54 -0.34 0.345 0 0 0</pose><geometry><cylinder><radius>0.025</radius><length>0.69</length></cylinder></geometry></collision>
        <visual name="leg_3_visual"><pose>-0.54 -0.34 0.345 0 0 0</pose><geometry><cylinder><radius>0.025</radius><length>0.69</length></cylinder></geometry><material><ambient>0.55 0.40 0.25 1</ambient><diffuse>0.55 0.40 0.25 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>
