        <visual name="crown_visual"><pose>0 0 2.6 0 0 0</pose><geometry><sphere><radius>1</radius></sphere></geometry><material><ambient>0.20 0.45 0.18 1</ambient><diffuse>0.20 0.45 0.18 1</diffuse></material></visual>
