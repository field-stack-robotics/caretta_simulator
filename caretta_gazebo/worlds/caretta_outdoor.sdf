        <visual name="trunk_visual"><pose>0 0 1.6 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>3.2</length></cylinder></geometry><material><ambient>0.40 0.28 0.18 1</ambient><diffuse>0.40 0.28 0.18 1</diffuse></material></visual>
