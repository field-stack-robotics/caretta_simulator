      </link>
    </model>
    <!-- fence posts along the south edge (y = -6): a long straight row, like a field border -->
    <model name="fence">
      <static>true</static>
      <link name="link">
        <collision name="post_0_collision"><pose>-6 -6 0.5 0 0 0</pose><geometry><box><size>0.1 0.1 1</size></box></geometry></collision>
