        <visual name="trunk_visual"><pose>0 0 1.2 0 0 0</pose><geometry><cylinder><radius>0.12</radius><length>2.4</length></cylinder></geometry><material><ambient>0.40 0.28 0.18 1</ambient><diffuse>0.40 0.28 0.18 1</diffuse></material></visual>
        <visual name="crown_visual"><pose>0 0 3 0 0 0</pose><geometry><sphere><radius>1</radius></sphere></geometry><material><ambient>0.20 0.45 0.18 1</ambient><diffuse>0.20 0.45 0.18 1</diffuse></material></visual>
      </link>
    </model>
    <model name="tree_11">
      <static>true</static>
      <pose>-4 8 0 0 0 0</pose>
      <link name="link">
        <collision name="trunk_collision"><pose>0 0 1.4 0 0 0</pose><geometry><cylinder><radius>0.18</radius><length>2.8</length></cylinder></geometry></collision>
        <visual name="trunk_visual"><pose>0 0 1.4 0 0 0</pose><geometry><cylinder><radius>0.18</radius><length>2.8</length></cylinder></geometry><material><ambient>0.40 0.28 0.18 1</ambient><diffuse>0.40 0.28 0.18 1</diffuse></material></visual>
        <visual name="crown_visual"><pose>0 0 3.4 0 0 0</pose><geometry><sphere><radius>1.2</radius></sphere></geometry><material><ambient>0.20 0.45 0.18 1</ambient><diffuse>0.20 0.45 0.18 1</diffuse></material></visual>
