    <!-- small shed inside the loop -->
    <model name="shed">
      <static>true</static>
      <pose>15 10 1.25 0 0 0.2</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>5 3.5 2.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>5 3.5 2.5</size></box></geometry><material><ambient>0.70 0.62 0.50 1</ambient><diffuse>0.70 0.62 0.50 1</diffuse></material></visual>
        <visual name="roof_visual"><pose>0 0 1.35 0 0 0</pose><geometry><box><size>5.4 3.9 0.2</size></box></geometry><material><ambient>0.45 0.20 0.15 1</ambient><diffuse>0.45 0.20 0.15 1</diffuse></material></visual>
