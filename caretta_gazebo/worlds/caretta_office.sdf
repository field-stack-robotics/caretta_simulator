<?xml version="1.0" ?>
<!-- Caretta office world (Ignition Gazebo Fortress): a SLAM challenge, 30 x 20 m building.
     x -6..24, y -10..10; robot spawns at (0, 0) in the lobby, facing +x (the long corridor).
     Hard parts on purpose:
       - long corridor (20 m, 1.5 m wide, plain walls): scans look the same along it
       - four identical offices with the same furniture: easy to confuse (wrong loop closure)
       - big warehouse (20 x 9 m) with a regular grid of columns and racks
       - open office with desk islands in a row, cluttered storage with narrow aisles
       - loops of different sizes: corridor -> connector -> north corridor -> kitchen -> lobby (~55 m)
     Generated by a script; walls 0.5 m high (LiDAR scan plane ~0.146 m). -->
<sdf version="1.8">
  <world name="caretta_office">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-contact-system" name="gz::sim::systems::Contact"/>
    <!-- needed for every sensor (gpu_lidar, camera ...) -->
    <plugin filename="ignition-gazebo-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <!-- needed for the IMU sensor (BNO055) -->
    <plugin filename="ignition-gazebo-imu-system" name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="building">
      <static>true</static>
      <link name="link">
        <collision name="outer_s_0_collision"><pose>9.000 -10.000 0.250 0 0 0.000</pose><geometry><box><size>30.100 0.100 0.500</size></box></geometry></collision>
        <visual name="outer_s_0_visual"><pose>9.000 -10.000 0.250 0 0 0.000</pose><geometry><box><size>30.100 0.100 0.500</size></box></geometry><material><ambient>0.55 0.58 0.62 1</ambient><diffuse>0.55 0.58 0.62 1</diffuse></material></visual>
        <collision name="outer_n_0_collision"><pose>9.000 10.000 0.250 0 0 0.000</pose><geometry><box><size>30.100 0.100 0.500</size></box></geometry></collision>
        <visual name="outer_n_0_visual"><pose>9.000 10.000 0.250 0 0 0.000</pose><geometry><box><size>30.100 0.100 0.500</size></box></geometry><material><ambient>0.55 0.58 0.62 1</ambient><diffuse>0.55 0.58 0.62 1</diffuse></material></visual>
